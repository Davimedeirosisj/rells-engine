# Porta da aplicação local
PORT=3000

# Exposição de rede: mantenha vazio para aceitar somente acesso local.
HOST=127.0.0.1
ALLOW_REMOTE=0

# Obrigatório quando HOST não for local e ALLOW_REMOTE=1.
# Protege a interface e a API com autenticação HTTP Basic.
REMOTE_USERNAME=
REMOTE_PASSWORD=

# Caminho do executável do FFmpeg (opcional).
# Deixe vazio para detectar automaticamente no PATH.
FFMPEG_PATH=

# Caminho do executável do FFmpeg (opcional) para ffprobe (leitura de duração).
FFPROBE_PATH=

# --- Whisper (transcrição local) ---
# WHISPER_COMMAND: executável do Whisper (ex.: 'whisper', 'python', caminho completo).
#   Se vazio, tenta automaticamente: whisper → python -m whisper → py -m whisper.
WHISPER_COMMAND=

# WHISPER_MODULE: '1' ou 'true' para forçar execução via módulo Python (python -m whisper).
WHISPER_MODULE=

# WHISPER_MODEL: modelo de linguagem (turbo, base, small, medium, large-v3).
WHISPER_MODEL=turbo

# WHISPER_LANGUAGE: idioma do áudio para transcrição (código ISO 639-1).
WHISPER_LANGUAGE=pt

# WHISPER_OUTPUT_FORMAT: formato de saída (srt, vtt, txt, json, tsv).
WHISPER_OUTPUT_FORMAT=srt

# WHISPER_TIMEOUT_MS: timeout máximo em milissegundos para a execução do Whisper (padrão: 3600000 = 1h).
WHISPER_TIMEOUT_MS=3600000
